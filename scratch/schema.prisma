datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  attendant
  technician
  investor
}

enum LotStatus {
  OPEN
  IN_STOCK
  IN_SALES
  CLOSED
}

enum ProductStatus {
  available
  sold
  reserved
  in_repair
  SINISTER_LOST
}

enum InstallmentStatus {
  paid
  pending
  overdue
  blocked
  cancelled
}

enum TransactionType {
  AMORTIZATION
  PROFIT
  WITHDRAWAL
}

// 1. STORES (Unidades do CRM MDR - Reusada)
model Store {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  cnpj              String?
  address           String?
  phone             String?
  evolutionApiUrl   String?   @map("evolution_api_url")
  evolutionApiKey   String?   @map("evolution_api_key")
  evolutionInstance String?   @map("evolution_instance")
  logoUrl           String?   @map("logo_url")
  themeColor        String?   @default("#4BE277") @map("theme_color")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz

  profiles          Profile[]
  devices           Device[]
  sales             Sale[]

  @@map("stores")
}

// 2. PROFILES (Usuários / Colaboradores / Investidores - Reusada & Estendida)
model Profile {
  id        String    @id @db.Uuid
  storeId   String?   @map("store_id") @db.Uuid
  fullName  String?   @map("full_name")
  avatarUrl String?   @map("avatar_url")
  role      Role      @default(attendant)
  active    Boolean?  @default(true)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  store     Store?    @relation(fields: [storeId], references: [id])
  sales     Sale[]    @relation("SellerSales")

  // Novas Relações para a Plataforma de Investidores SCP
  quotas       InvestorQuota[]
  transactions WalletTransaction[]
  wallet       Wallet?

  @@map("profiles")
}

// 3. LOT (Lote de Investimento SCP - NOVO)
model Lot {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  targetAmount Decimal         @map("target_amount") @db.Decimal(12, 2)
  status       LotStatus       @default(OPEN)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  
  products     Device[]        // Relação de aparelhos adquiridos para este lote
  quotas       InvestorQuota[] // Participação dos investidores parceiros

  @@map("lots")
}

// 4. INVESTOR QUOTA (Cotas de Investidores por Lote SCP - NOVO)
model InvestorQuota {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId           String   @map("profile_id") @db.Uuid
  lotId               String   @map("lot_id") @db.Uuid
  amountInvested      Decimal  @map("amount_invested") @db.Decimal(12, 2)
  ownershipPercentage Decimal  @map("ownership_percentage") @db.Decimal(5, 4) // Proporção do lote (ex: 0.1500 para 15%)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile             Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lot                 Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([profileId, lotId])
  @@map("investor_quotas")
}

// 5. DEVICES (Aparelhos / Produtos - Reusada & Conectada ao Lote)
model Device {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String?       @map("store_id") @db.Uuid
  lotId         String?       @map("lot_id") @db.Uuid // Novo campo de link ao lote SCP
  model         String
  brand         String
  imei          String?       @unique
  serialNumber  String?       @unique @map("serial_number")
  condition     String?       // "new", "used", "refurbished"
  costPrice     Decimal       @map("cost_price") @db.Decimal(12, 2)
  salePrice     Decimal       @map("sale_price") @db.Decimal(12, 2)
  stockQuantity Int?          @default(1) @map("stock_quantity")
  status        ProductStatus @default(available)
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamptz

  store         Store?        @relation(fields: [storeId], references: [id])
  lot           Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  sales         Sale[]

  @@map("devices")
}

// 6. SALES (Vendas - Reusada)
model Sale {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId            String?       @map("store_id") @db.Uuid
  customerId         String?       @map("customer_id") @db.Uuid
  sellerId           String?       @map("seller_id") @db.Uuid
  deviceId           String?       @map("device_id") @db.Uuid
  deviceModelManual  String?       @map("device_model_manual")
  imeiManual         String?       @map("imei_manual")
  totalValue         Decimal       @map("total_value") @db.Decimal(12, 2)
  downPayment        Decimal?      @default(0) @map("down_payment") @db.Decimal(12, 2)
  installmentsCount  Int?          @default(1) @map("installments_count")
  serviceFee         Decimal?      @default(0) @map("service_fee") @db.Decimal(12, 2)
  originalPrice      Decimal?      @default(0) @map("original_price") @db.Decimal(12, 2)
  saleDate           DateTime?     @default(dbgenerated("CURRENT_DATE")) @map("sale_date") @db.Date
  status             String?       @default("completed") // "completed", "cancelled", "refunded"
  paymentType        String?       @map("payment_type") // "crediario", "card", "vista"
  createdAt          DateTime?     @default(now()) @map("created_at") @db.Timestamptz

  store              Store?        @relation(fields: [storeId], references: [id])
  seller             Profile?      @relation("SellerSales", fields: [sellerId], references: [id])
  device             Device?       @relation(fields: [deviceId], references: [id])
  installments       Installment[]

  @@map("sales")
}

// 7. INSTALLMENTS (Parcelas a Receber - Reusada)
model Installment {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId            String            @map("sale_id") @db.Uuid
  installmentNumber Int               @map("installment_number")
  totalInstallments Int               @map("total_installments")
  value             Decimal           @db.Decimal(12, 2)
  dueDate           DateTime          @map("due_date") @db.Date
  paymentDate       DateTime?         @map("payment_date") @db.Timestamptz
  status            InstallmentStatus @default(pending)
  paymentMethod     String?           @map("payment_method")
  createdAt         DateTime?         @default(now()) @map("created_at") @db.Timestamptz

  sale              Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("installments")
}

// 8. WALLET (Carteira Financeira do Investidor SCP - NOVO)
model Wallet {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId      String   @unique @map("profile_id") @db.Uuid
  balance        Decimal  @default(0) @db.Decimal(12, 2) // Saldo livre para saque
  futureReceipts Decimal  @default(0) @map("future_receipts") @db.Decimal(12, 2) // Recebíveis futuros pendentes
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// 9. WALLET TRANSACTION (Histórico de Movimentações da Carteira SCP - NOVO)
model WalletTransaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String          @map("profile_id") @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  profile     Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}
