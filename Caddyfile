{
    email admin@mdrinformaticaecelulares.com.br
}

# --- CRM App ---
mdrinformaticaecelulares.com.br, api.mdrinformaticaecelulares.com.br {
    reverse_proxy app:3000
    encode gzip
}

# --- Supabase API (Kong) com CORS TOTAL ---
supabase.mdrinformaticaecelulares.com.br {
    reverse_proxy supabase-kong:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    # Liberação total de CORS para evitar novos erros de headers
    header {
        Access-Control-Allow-Origin https://mdrinformaticaecelulares.com.br
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "*"
        Access-Control-Expose-Headers "*"
        Access-Control-Allow-Credentials true
        defer
    }

    # Responder rapidamente a requisições de teste (OPTIONS)
    @options {
        method OPTIONS
    }
    respond @options 204
}

# --- Supabase Dashboard (Studio) ---
studio.mdrinformaticaecelulares.com.br {
    reverse_proxy supabase-studio:3000
}

# --- n8n ---
n8n.mdrinformaticaecelulares.com.br {
    reverse_proxy crm-mdr-n8n-1:5678
}

# --- Evolution API ---
whatsapp.mdrinformaticaecelulares.com.br {
    reverse_proxy crm-mdr-evolution-1:8080
}

# --- Chatwoot ---
chat.mdrinformaticaecelulares.com.br {
    reverse_proxy chatwoot-web:3000 {
        header_down -X-Frame-Options
        header_down -Content-Security-Policy
    }
    encode gzip
}

# --- Headwind MDM ---
mdm.mdrinformaticaecelulares.com.br {
    reverse_proxy hmdm:8080
}

