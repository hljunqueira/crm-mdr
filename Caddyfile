# --- CRM App ---
mdrinformaticaecelulares.com.br, api.mdrinformaticaecelulares.com.br {
    reverse_proxy app:3000
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
    }
}

# --- Supabase API (Kong) ---
supabase.mdrinformaticaecelulares.com.br {
    reverse_proxy supabase-kong:8000
    encode gzip
}

# --- Supabase Dashboard (Studio) ---
studio.mdrinformaticaecelulares.com.br {
    reverse_proxy supabase-studio:3000
    encode gzip
}

# --- n8n ---
n8n.mdrinformaticaecelulares.com.br {
    reverse_proxy n8n:5678
    encode gzip
}

# --- Evolution API ---
whatsapp.mdrinformaticaecelulares.com.br {
